<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingEnd="@dimen/screen_horizontal_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/image_home_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_voice2note_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/home_prompt"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/home_description"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/button_home_record"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_primary_pill"
        android:drawableStart="@android:drawable/ic_btn_speak_now"
        android:drawablePadding="8dp"
        android:drawableTint="@color/on_primary_coral"
        android:minHeight="@dimen/min_touch_target"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/home_record"
        android:textAllCaps="false"
        android:textColor="@color/on_primary_coral"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_home_upload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_pill"
            android:minHeight="@dimen/min_touch_target"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/home_upload"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/button_home_new_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_pill"
            android:minHeight="@dimen/min_touch_target"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/home_new_note"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_recent_notes"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_home_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:minHeight="@dimen/min_touch_target"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/home_view_all"
            android:textAllCaps="false"
            android:textColor="@color/secondary_rose" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_home_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/search_result_background"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/home_empty"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:id="@+id/home_recent_notes_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
