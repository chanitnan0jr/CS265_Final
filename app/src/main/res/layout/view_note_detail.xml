<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingEnd="@dimen/screen_horizontal_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_tonal"
            android:contentDescription="@string/detail_back_desc"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/button_detail_options"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_tonal"
            android:contentDescription="@string/detail_options_desc"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/note_options_symbol"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_rename_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/input_detail_rename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_box"
            android:hint="@string/detail_rename_hint"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:minHeight="@dimen/min_touch_target"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:id="@+id/text_detail_rename_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/status_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_detail_rename_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_primary_pill"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/detail_rename_save"
                android:textAllCaps="false"
                android:textColor="@color/on_primary_coral" />

            <Button
                android:id="@+id/button_detail_rename_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/detail_rename_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/text_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_detail_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_detail_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_detail_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/detail_transcription_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tonal_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_detail_transcription_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_detail_transcription"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary_coral" />

        <TextView
            android:id="@+id/text_detail_transcription_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_detail_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_pill"
            android:minHeight="@dimen/min_touch_target"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/detail_retry_transcription"
            android:textAllCaps="false"
            android:textColor="@color/on_primary_coral"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_audio_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tonal_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/button_detail_play_small"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_coral"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="▶"
            android:textColor="@color/on_primary_coral"
            android:textSize="13sp" />

        <com.example.cs265final.ui.WaveformView
            android:id="@+id/waveform_detail"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/text_detail_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_body_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/search_result_background"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_detail_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/button_detail_listen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_primary_pill"
        android:minHeight="@dimen/min_touch_target"
        android:text="@string/detail_listen_original"
        android:textAllCaps="false"
        android:textColor="@color/on_primary_coral"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_detail_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.35"
            android:background="@drawable/bg_secondary_pill"
            android:minHeight="@dimen/min_touch_target"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/detail_copy_text"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/button_detail_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.85"
            android:background="@drawable/bg_secondary_pill"
            android:minHeight="@dimen/min_touch_target"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/detail_edit"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/button_detail_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.8"
            android:background="@drawable/bg_secondary_pill"
            android:minHeight="@dimen/min_touch_target"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/detail_share"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
