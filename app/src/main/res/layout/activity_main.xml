<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_storage_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_coral_soft"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="10dp"
        android:text="@string/storage_read_error"
        android:textColor="@color/status_error"
        android:textSize="13sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:id="@+id/main_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/screen_vertical_padding"
            android:paddingBottom="20dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_nav"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_soft" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="@dimen/min_touch_target"
                android:padding="4dp"
                android:text="@string/nav_home"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nav_library"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="@dimen/min_touch_target"
                android:padding="4dp"
                android:text="@string/nav_library"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nav_calendar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="@dimen/min_touch_target"
                android:padding="4dp"
                android:text="@string/nav_calendar"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nav_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="@dimen/min_touch_target"
                android:padding="4dp"
                android:text="@string/nav_search"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
