<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingEnd="@dimen/screen_horizontal_padding">

    <Button
        android:id="@+id/button_playback_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:minHeight="@dimen/min_touch_target"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:text="@string/playback_back"
        android:textAllCaps="false"
        android:textColor="@color/primary_coral" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/playback_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_playback_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/playback_loading"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seekbar_playback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:minHeight="@dimen/min_touch_target" />

    <TextView
        android:id="@+id/text_playback_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0:00 / 0:00"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/button_playback_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_primary_pill"
        android:enabled="false"
        android:minHeight="@dimen/min_touch_target"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/playback_play"
        android:textAllCaps="false"
        android:textColor="@color/on_primary_coral"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/playback_word_sync_note"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
