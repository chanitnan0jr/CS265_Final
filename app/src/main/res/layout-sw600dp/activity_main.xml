<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="176dp"
        android:layout_height="match_parent"
        android:background="@color/surface_nav"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="20dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/nav_home"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/nav_library"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/nav_library"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/nav_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/nav_calendar"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/nav_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/nav_search"
                android:textAllCaps="false"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border_soft" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_storage_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_coral_soft"
            android:paddingStart="32dp"
            android:paddingTop="10dp"
            android:paddingEnd="32dp"
            android:paddingBottom="10dp"
            android:text="@string/storage_read_error"
            android:textColor="@color/status_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/main_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <FrameLayout
                android:id="@+id/main_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
